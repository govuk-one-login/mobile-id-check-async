{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.11.0/schemas/schema.json",
  "services": [
    {
      "serviceTag": "mobile-id-check",
      "promotionType": "securePipelines",
      "checks": [
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/backend-api-pull-request.yml",
            "path": "$.jobs.ci-checks"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "contract",
            "secret scanning",
            "sensitive data scanning",
            "unit",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/backend-api-pull-request.yml",
            "path": "$.jobs.run-test-suite"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test-resources-pull-request.yml",
            "path": "$.jobs.ci-checks"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "secret scanning",
            "sensitive data scanning",
            "unit",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test-resources-pull-request.yml",
            "path": "$.jobs.run-test-suite"
          }
        }
      ]
    }
  ]
}
