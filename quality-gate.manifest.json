{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.17.0/schemas/schema.json",
  "services": [
    {
      "product": "ID Check Async",
      "component": "id-check-async",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/backend-api-pull-request.yml",
          "path": "$.jobs.ci-checks"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "contract"
            },
            {
              "name": "secret scanning"
            },
            {
              "name": "sensitive data scanning"
            },
            {
              "name": "unit"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/backend-api-pull-request.yml",
          "path": "$.jobs.run-test-suite"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/test-resources-pull-request.yml",
          "path": "$.jobs.ci-checks"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            },
            {
              "name": "sensitive data scanning"
            },
            {
              "name": "unit"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/test-resources-pull-request.yml",
          "path": "$.jobs.run-test-suite"
        }
      ]
    }
  ]
}
